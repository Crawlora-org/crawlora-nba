{
  "name": "crawlora/nba",
  "description": "Crawlora NBA API client with 70 endpoints for games, standings, player and team statistics, play-by-play, and dashboards",
  "keywords": [
    "crawlora",
    "api-client",
    "sdk",
    "web-scraping",
    "scraping-api",
    "nba",
    "nba-api",
    "nba-scraper",
    "nba-data",
    "nba-games",
    "nba-standings",
    "nba-player-team-statistics",
    "nba-play-play",
    "nba-dashboards"
  ],
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "Crawlora\\Nba\\": "src/Crawlora/Nba/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Crawlora\\Nba\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "php tests/client_test.php"
  },
  "homepage": "https://crawlora.net/?utm_source=packagist&utm_medium=referral&utm_campaign=platform-clients&utm_content=nba-php-homepage",
  "support": {
    "source": "https://github.com/Crawlora-org/crawlora-nba",
    "docs": "https://crawlora.net/docs?utm_source=packagist&utm_medium=referral&utm_campaign=platform-clients&utm_content=nba-php-api-docs"
  }
}
