{
  "name": "@crawlora-org/nba",
  "version": "0.1.0",
  "description": "Crawlora NBA API client with 70 endpoints for games, standings, player and team statistics, play-by-play, and dashboards",
  "homepage": "https://crawlora.net/?utm_source=npm&utm_medium=referral&utm_campaign=platform-clients&utm_content=nba-javascript-homepage",
  "bugs": { "url": "https://github.com/Crawlora-org/crawlora-nba/issues" },
  "keywords": ["crawlora", "api-client", "sdk", "web-scraping", "scraping-api", "nba", "nba-api", "nba-scraper", "nba-data", "nba-games", "nba-standings", "nba-player-team-statistics", "nba-play-play", "nba-dashboards"],
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": ["src", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Crawlora-org/crawlora-nba",
    "directory": "javascript"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "generate": "python3 ../scripts/generate.py"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
